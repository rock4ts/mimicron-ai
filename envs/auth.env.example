LOG_LEVEL=INFO
PROD_RUN=false
ROOT_PATH=/auth/api
REQUEST_ID_HEADER=x-request-id

YANDEXID_CLIENT_ID=your-client-id
YANDEXID_CLIENT_SECRET=your-client-secret
# Register this exact URL in the Yandex OAuth application.
YANDEXID_REDIRECT_URL=http://localhost:3000/api/auth/yandex/callback

# Set these only behind a trusted ingress. The BFF does not forward client IPs
# in local direct-Next mode, so rate limits see the BFF address.
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_IPS=frontend

RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_LIMIT=5
RATE_LIMIT_IP_WINDOW_SECONDS=60
