LOG_LEVEL=INFO
PROD_RUN=false
ROOT_PATH=/auth/api
REQUEST_ID_HEADER=x-request-id

YANDEXID_CLIENT_ID=your-client-id
YANDEXID_CLIENT_SECRET=your-client-secret
# Keep the auth-service callback until a Next.js BFF callback exists.
YANDEXID_REDIRECT_URL=http://localhost:8000/yandexid/token

RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_LIMIT=5
RATE_LIMIT_IP_WINDOW_SECONDS=60
