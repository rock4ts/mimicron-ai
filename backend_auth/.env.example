POSTGRES_DB=auth
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_PRIVATE_KEY_PATH=certs/jwt-private.pem
JWT_PUBLIC_KEY_PATH=certs/jwt-public.pem

PROD_RUN=false
LOG_LEVEL=INFO
ROOT_PATH=
REQUEST_ID_HEADER=x-request-id

YANDEXID_CLIENT_ID=your-client-id
YANDEXID_CLIENT_SECRET=your-client-secret
YANDEXID_REDIRECT_URL=http://localhost:8000/yandexid/token

RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_LIMIT=5
RATE_LIMIT_IP_WINDOW_SECONDS=60
