POSTGRES_DB=mimicron_test
POSTGRES_USER=mimicron_test
POSTGRES_PASSWORD=mimicron_test
POSTGRES_HOST=postgres_test
POSTGRES_PORT=5432
LLM_API_KEY=test-key-not-used
LLM_MODEL=GigaChat-2
LLM_TIMEOUT_SECONDS=0.5
EMBEDDING_PROVIDER=gigachat
EMBEDDING_API_KEY=test-key-not-used
EMBEDDING_MODEL=Embeddings
EMBEDDING_DIMENSIONS=8
EMBEDDING_TIMEOUT_SECONDS=0.5
QDRANT_URL=http://qdrant_test:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=memories_test
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT_SECONDS=5
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_RETRIEVAL_SCORE_THRESHOLD=0.70
MEMORY_MANAGEMENT_TOP_K=10
MEMORY_MANAGEMENT_SCORE_THRESHOLD=0.55
LOG_LEVEL=WARNING
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=tests/docker/certs/jwt-public.pem
JWT_PRIVATE_KEY_PATH=tests/docker/certs/jwt-private.pem
